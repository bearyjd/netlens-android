# Ignore .omc contents (state, sessions, project-memory) but KEEP learned skills.
# Must be `.omc/*` not `.omc/` — a trailing-slash exclude stops Git descending into the
# directory at all, so a negation inside it can never re-include anything.
.omc/*
!.omc/skills/
.gstack/
.kotlin/
*.jks
*.keystore
.claude/PRPs/
.claude/scheduled_tasks.lock

# fastlane / Play publishing — never commit the service-account key
fastlane/play-service-account.json
fastlane/*.json
fastlane/report.xml
fastlane/README.md
